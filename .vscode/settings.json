{
  "workbench.editor.customLabels.patterns": {
    "**/app/**/page.tsx": "${dirname(1)}/${dirname} - page.tsx",
    "**/app/**/layout.tsx": "${dirname(1)}/${dirname} - layout.tsx",
    "**/app/**/loading.tsx": "${dirname(1)}/${dirname} - loading.tsx",
    "**/app/**/error.tsx": "${dirname(1)}/${dirname} - error.tsx",
    "**/app/**/not-found.tsx": "${dirname(1)}/${dirname} - not-found.tsx",
    "**/app/**/template.tsx": "${dirname(1)}/${dirname} - template.tsx",
    "**/app/**/default.tsx": "${dirname(1)}/${dirname} - default.tsx",
    "**/app/**/route.ts": "${dirname(1)}/${dirname} - route.ts",
    "**/styles/**/shared.css": "${dirname(1)}/${dirname} - shared.css",
    "**/data/**/*.json": "${dirname(1)}/${dirname} - ${filename}.json (data)",
    "**/schema/**/*.json": "${dirname(1)}/${dirname} - ${filename}.json (schema)",
    "**/**/.gitplaceholder": "${dirname(-2)}/*/${dirname}/.gitplaceholder"
  },
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "chat.agent.enabled": false,
  "chat.agent.sandbox.network.allowNetwork": false,
  "chat.agent.sandbox.allowUnsandboxedCommands": false,
  "chat.mcp.access": "none",
  "inlineChat.fixDiagnostics": false,
  "chat.disableAIFeatures": true,
  "html.format.indentInnerHtml": true,
  "html.format.wrapAttributes": "force-expand-multiline",
  "githubPullRequests.queries": [
    {
      "label": "My Review Needed",
      "query": "is:open review-requested:${user}"
    },
    {
      "label": "Assigned To Me",
      "query": "is:open assignee:${user}"
    },
    {
      "label": "Created By Me",
      "query": "author:${user}"
    },
    {
      "label": "Mentions Me",
      "query": "is:open mentions:${user}"
    },
    {
      "label": "Other Open In My Repo",
      "query": "is:open -assignee:${user} repo:${owner}/${repository}"
    }
  ],
  "githubIssues.queries": [
    {
      "label": "My Issues",
      "query": "is:open assignee:${user} repo:${owner}/${repository}",
      "groupBy": ["milestone"]
    },
    {
      "label": "Open Issues",
      "query": "state:open repo:${owner}/${repository} sort:name"
    },
    {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
    }
  ],
  "githubIssues.issueBranchTitle": "${user}/${sanitizedLowercaseIssueTitle}",
  "githubIssues.workingBaseBranch": "prompt",
  "githubPullRequests.createDefaultBaseBranch": "createdFromBranch",
  "githubPullRequests.deleteBranchAfterMerge": true,
  "githubPullRequests.defaultDeletionMethod.selectLocalBranch": true,
  "githubPullRequests.defaultDeletionMethod.selectRemote": true,
  "githubPullRequests.postDone": "checkoutPullRequestBaseBranchAndPull",
  "githubPullRequests.ignoreSubmodules": true,
  "githubPullRequests.labelCreated": ["status:ready"],
  "iridium.npm.packageManager": "npm",
  "iridium.npm.runAudit": true,
  "iridium.npm.maxNumberOfResults": 6,
  "iridium.npm.excludeVersions": ["beta", "experimental"],
  "npm-intellisense.importQuotes": "\"",
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "stylelint.validate": [
    "css",
    "postcss",
    "javascriptreact",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "explicit"
  },
  "[html]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "never"
    }
  },
  "json.validate.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://librarianofstars.ca": true,
    "https://github.com": true,
    "https://raw.githubusercontent.com": true
  },
  "json.schemas": [
    {
      "fileMatch": [
        "${workspaceFolder}/schema/**/*.json",
        "${workspaceFolder}/schema/**/*.schema.json"
      ],
      "url": "https://json-schema.org/draft-07/schema#"
    },
    {
      "fileMatch": ["${workspaceFolder}/data/tests/types/key.json"],
      "url": "./schema/types/key.json"
    },
    {
      "fileMatch": ["${workspaceFolder}/data/example_test.json"],
      "url": "./schema/example.json"
    },
    {
      "fileMatch": [
        "${workspaceFolder}/data/tests/components/blocks/paragraph.json"
      ],
      "url": "./schema/components/blocks/paragraph.json"
    }
  ]
}
