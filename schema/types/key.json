{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://librarianofstars.ca/schema/types/key",
  "description": "A object storing a key for a array of element data",
  "properties": {
    "index": {
      "type": "number"
    },
    "name": {
      "type": "string"
    }
  },
  "required": ["index", "name"],
  "additionalProperties": false
}
