{
  "$id": "https://librarianofstars.ca/schema/components/elements/structure/section.json",
  "title": "section",
  "description": "The `Section` component's data",
  "type": "object",
  "properties": {
    "id": { "$ref": "https://librarianofstars.ca/schema/types/key.json" },
    "heading": {
      "description": "The title or heading for this section ",
      "$ref": "https://librarianofstars.ca/schema/components/elements/heading.json",
      "default": { "className": "section-title" }
    },
    "contents": {
      "type": "array",
      "description": "What makes up the body of this section",
      "items": {
        "description": "Either a Block or another Section",
        "anyOf": [
          {
            "$ref": "https://librarianofstars.ca/schema/components/blocks/generic.json"
          },
          {
            "$ref": "#",
            "$comment": "self-referential nesting"
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": ["id", "heading", "contents"],
  "additionalProperties": false
}
