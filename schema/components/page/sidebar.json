{
  "$id": "https://librarianofstars.ca/schema/components/page/sidebar.json",
  "type": "array",
  "title": "sidebar",
  "description": "The sidebar component's data for a page",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "description": "Table of contents item in sidebar",
        "properties": {
          "id": { "$ref": "https://librarianofstars.ca/schema/types/key.json" },
          "section_type": {
            "type": "string",
            "enum": ["TOC"],
            "description": "Discriminator for sidebar sections (unused)"
          },
          "contents": {
            "$ref": "https://librarianofstars.ca/schema/components/elements/structure/table_of_contents.json"
          }
        },
        "required": ["id", "section_type", "contents"],
        "additionalProperties": false
      },
      { "$comment": "Add more later?" }
    ]
  }
}
