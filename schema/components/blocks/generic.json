{
  "$id": "https://librarianofstars.ca/schema/components/blocks/generic.json",
  "description": "Any of the block schema",
  "type": "object",
  "properties": {
    "block_type": {
      "type": "string",
      "enum": ["gallery", "links", "paragraph"]
    },
    "contents": {
      "anyOf": [
        {
          "$ref": "https://librarianofstars.ca/schema/components/blocks/gallery.json"
        },
        {
          "$ref": "https://librarianofstars.ca/schema/components/blocks/links.json"
        },
        {
          "$ref": "https://librarianofstars.ca/schema/components/blocks/paragraph.json"
        }
      ]
    }
  },
  "required": ["block_type", "contents"]
}
